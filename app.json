{
  "expo": {
    "name": "flight-tracker",
    "slug": "flight-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "flighttracker",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.flighttracker.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Shows your location on the map."
      }
    },
    "android": {
      "package": "com.flighttracker.app",
      "permissions": ["ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION"],
      "adaptiveIcon": {
        "backgroundColor": "#F4F4F5",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F4F4F5"
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Adds your flights to your calendar.",
          "writeOnlyCalendarPermission": "Adds your flights to your calendar.",
          "writeOnlyAccess": true
        }
      ],
      "expo-widgets"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
